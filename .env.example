# Not read by the server: mcp-gog-bridge takes its configuration from the process
# environment only, which for Claude Desktop is the "env" block of its config.
# This file documents the variables and their shape.

# Required. Absolute path of the gog executable, gog.exe on Windows.
GOG_BRIDGE_EXE=C:\Users\you\gog\gog.exe

# Required. The accounts the bridge may act on, as alias=email pairs separated by
# commas. The alias is what the model types in gog_run's account parameter, the
# address is what gog receives. Aliases match ^[a-z][a-z0-9_-]{0,31}$ and must be
# unique. With a single pair, account may be left out and defaults to it.
GOG_BRIDGE_ACCOUNTS=perso=you@gmail.com,work=you@company.com

# Optional. Seconds before a gog command is killed and reported as exit_code -1.
GOG_BRIDGE_TIMEOUT_SECONDS=120
